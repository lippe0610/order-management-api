# Configuración de la aplicación
APP_NAME="Order Management API"
VERSION="1.0.0"
DEBUG=true

# Configuración de CORS
# Para desarrollo: ["*"]
# Para producción: ["https://yourdomain.com", "https://www.yourdomain.com"]
ALLOWED_ORIGINS=["*"]

# Configuración de costos de envío por estrato (opcional)
# Si no se especifica, se usan los valores por defecto en config.py
SHIPPING_COST_STRATUM_1=8000
SHIPPING_COST_STRATUM_2=8000
SHIPPING_COST_STRATUM_3=6000
SHIPPING_COST_STRATUM_4=5000
SHIPPING_COST_STRATUM_5=0
SHIPPING_COST_STRATUM_6=0

# Configuración de descuentos (opcional)
DISCOUNT_THRESHOLD=100000  # Monto mínimo para aplicar descuento en COP
DISCOUNT_RATE=0.10         # Porcentaje de descuento (0.10 = 10%)

# Costo de envío por defecto para estratos no definidos
DEFAULT_SHIPPING_COST=6000

# Configuración del servidor
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Configuración de logs
LOG_LEVEL=info
LOG_FORMAT=json

# Base de datos (para futuras expansiones)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# Redis para caché (para futuras expansiones)
# REDIS_URL=redis://localhost:6379/0

# Configuración de monitoreo (para futuras expansiones)
# SENTRY_DSN=https://your-sentry-dsn
# PROMETHEUS_ENABLED=true

